<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".bookings">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="25dp"


        android:gravity="center"
        >
        <Button
            android:id="@+id/homeButton"
            android:layout_marginEnd="50dp"
            android:background="@drawable/house"
            app:backgroundTint="@color/Gold"
            android:layout_width="64dp"
            android:layout_height="64dp"

            />

        <Button
            android:id="@+id/staffButton"
            android:background="@drawable/staff"
            app:backgroundTint="@color/Gold"
            android:layout_width="64dp"
            android:layout_height="64dp"

            />

        <Button
            android:background="@drawable/cog"
            app:backgroundTint="@color/Gold"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="50dp"


            />
    </LinearLayout>

    <Button
        android:id="@+id/backButton"
        android:layout_marginTop="16dp"
        android:background="@drawable/returnbutton"
        android:textColor="@color/black"
        app:backgroundTint="@color/Gold"

        android:layout_width="64dp"
        android:layout_height="64dp"
        android:orientation="vertical"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="25dp"

        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginBottom="100dp"
        android:background="@color/Gold"
        android:textColor="@color/Gold"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <TextView
        android:id="@+id/bookingTimeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bookings"
        android:fontFamily="@font/cinzel"
        android:textColor="@color/Gold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginBottom="550dp"
        android:textSize="30sp"
        />

    <Button
        android:id="@+id/bookingconfirmButton"
        app:backgroundTint="@color/Gold"
        android:layout_width="256dp"
        android:layout_height="64dp"
        android:layout_marginTop="100dp"
        android:text="Confirm"
        android:fontFamily="@font/cinzel"
        android:textSize="18sp"
        android:textColor="@color/black"

        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="160dp"
        />

    <CalendarView
        android:id="@+id/calendarView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginBottom="160dp"
        android:background="@color/Gold"
        />


</androidx.constraintlayout.widget.ConstraintLayout>
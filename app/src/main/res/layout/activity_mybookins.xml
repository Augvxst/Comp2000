<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Mybookins">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="25dp"


        android:gravity="center"
        >
        <Button
            android:id="@+id/homeButton"
            android:layout_marginEnd="50dp"
            android:background="@drawable/house"
            app:backgroundTint="@color/Gold"
            android:layout_width="64dp"
            android:layout_height="64dp"

            />

        <Button
            android:id="@+id/staffButton"
            android:background="@drawable/staff"
            app:backgroundTint="@color/Gold"
            android:layout_width="64dp"
            android:layout_height="64dp"

            />

        <Button
            android:background="@drawable/cog"
            app:backgroundTint="@color/Gold"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="50dp"


            />
    </LinearLayout>

    <Button
        android:id="@+id/backButton"
        android:layout_marginTop="16dp"
        android:background="@drawable/returnbutton"
        android:textColor="@color/black"
        app:backgroundTint="@color/Gold"

        android:layout_width="64dp"
        android:layout_height="64dp"
        android:orientation="vertical"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="25dp"

        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginBottom="100dp"
        android:background="@color/Gold"
        android:textColor="@color/Gold"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <TextView
        android:id="@+id/MyBookingsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Bookings"
        android:fontFamily="@font/cinzel"
        android:textColor="@color/Gold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginBottom="500dp"
        android:textSize="40sp"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/messageButton1"
            android:layout_width="300dp"
            android:layout_height="60dp"
            android:text="Room 1 | 2nd March | 9:00- 10:00"
            app:backgroundTint="@color/Gold" />

        <Button
            android:id="@+id/messageButton2"
            android:layout_width="300dp"
            android:layout_height="60dp"
            android:text="Room 3 | 6th June | 12:00- 1:00"
            app:backgroundTint="@color/Gold" />

        <Button
            android:id="@+id/messageButton3"
            android:layout_width="300dp"
            android:layout_height="60dp"
            android:text="Room 5 | 16th August | 10:00- 11:00"
            app:backgroundTint="@color/Gold" />

        <Button
            android:id="@+id/messageButton4"
            android:layout_width="300dp"
            android:layout_height="60dp"
            android:text="Room 4 | 18th April | 2:00- 3:00"
            app:backgroundTint="@color/Gold" />

        <Button
            android:id="@+id/messageButton5"
            android:layout_width="300dp"
            android:layout_height="60dp"
            android:text="Room 2 | 1st January | 1:00- 2:00"
            app:backgroundTint="@color/Gold" />

        <Button
            android:id="@+id/messageButton6"
            android:layout_width="300dp"
            android:layout_height="60dp"
            android:text="Room 1 | 24th July | 3:00- 4:00"
            app:backgroundTint="@color/Gold" />


    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
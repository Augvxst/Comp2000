<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".bookingtimes">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="25dp"


        android:gravity="center"
        >
        <Button
            android:id="@+id/homeButton"
            android:layout_marginEnd="50dp"
            android:background="@drawable/house"
            app:backgroundTint="@color/Gold"
            android:layout_width="64dp"
            android:layout_height="64dp"

            />

        <Button
            android:id="@+id/staffButton"
            android:background="@drawable/staff"
            app:backgroundTint="@color/Gold"
            android:layout_width="64dp"
            android:layout_height="64dp"

            />

        <Button
            android:background="@drawable/cog"
            app:backgroundTint="@color/Gold"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="50dp"


            />
    </LinearLayout>

    <Button
        android:id="@+id/backButton"
        android:layout_marginTop="16dp"
        android:background="@drawable/returnbutton"
        android:textColor="@color/black"
        app:backgroundTint="@color/Gold"

        android:layout_width="64dp"
        android:layout_height="64dp"
        android:orientation="vertical"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="25dp"

        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginBottom="100dp"
        android:background="@color/Gold"
        android:textColor="@color/Gold"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <TextView
        android:id="@+id/bookingTimeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bookings"
        android:fontFamily="@font/cinzel"
        android:textColor="@color/Gold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginBottom="550dp"
        android:textSize="30sp"
        />

    <Button
        android:id="@+id/bookingconfirmButton"
        android:layout_width="256dp"
        android:layout_height="64dp"
        android:layout_marginBottom="172dp"
        android:fontFamily="@font/cinzel"
        android:orientation="horizontal"
        android:text="Confirm"
        android:textColor="@color/black"

        android:textSize="18sp"
        app:backgroundTint="@color/Gold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/selectTimeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select a Time"
        android:textColor="@color/Gold"
        android:textSize="28sp"
        android:fontFamily="@font/cinzel"
        android:layout_marginTop="180dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/selectedDateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/Gold"
        android:textSize="16sp"
        android:fontFamily="@font/cinzel"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/selectTimeTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <GridLayout
        android:id="@+id/timeGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="1dp"
        app:layout_constraintTop_toBottomOf="@id/selectedDateText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/time0900"
            style="@style/TimeSlotButton"
            android:text="09:00" />

        <Button
            android:id="@+id/time1000"
            style="@style/TimeSlotButton"
            android:text="10:00" />

        <Button
            android:id="@+id/time1100"
            style="@style/TimeSlotButton"
            android:text="11:00" />

        <Button
            android:id="@+id/time1200"
            style="@style/TimeSlotButton"
            android:text="12:00" />

        <Button
            android:id="@+id/time1300"
            style="@style/TimeSlotButton"
            android:text="13:00" />

        <Button
            android:id="@+id/time1400"
            style="@style/TimeSlotButton"
            android:text="14:00" />

        <Button
            android:id="@+id/time1500"
            style="@style/TimeSlotButton"
            android:text="15:00" />

        <Button
            android:id="@+id/time1600"
            style="@style/TimeSlotButton"
            android:text="16:00" />

        <Button
            android:id="@+id/time1700"
            style="@style/TimeSlotButton"
            android:text="17:00" />

    </GridLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
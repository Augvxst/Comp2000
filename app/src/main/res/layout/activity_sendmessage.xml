<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".sendmessage">

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="25dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/homeButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="50dp"
            android:background="@drawable/house"
            app:backgroundTint="@color/Gold" />

        <Button
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/staff"
            app:backgroundTint="@color/Gold" />

        <Button
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="50dp"
            android:background="@drawable/cog"
            app:backgroundTint="@color/Gold" />

    </LinearLayout>

    <Button
        android:id="@+id/backButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="25dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/returnbutton"
        app:backgroundTint="@color/Gold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginBottom="100dp"
        android:background="@color/Gold"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/messagesText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Messages"
        android:fontFamily="@font/cinzel"
        android:textColor="@color/Gold"
        android:textSize="30sp"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/messageForm"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="15dp"
        android:background="@color/Gold"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="50dp"
        app:layout_constraintTop_toBottomOf="@id/messagesText"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/recipientInput"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Staff Member"
            android:background="@color/black"
            android:padding="12dp"
            android:textColor="@color/Gold"
            android:textColorHint="@color/Gold"
            android:textSize="16sp"
            android:inputType="text" />

        <EditText
            android:id="@+id/subjectInput"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:hint="Subject"
            android:background="@color/black"
            android:padding="12dp"
            android:textColor="@color/Gold"
            android:textColorHint="@color/Gold"
            android:textSize="16sp"
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:gravity="top|start"
            android:hint="Write your message here..."
            android:background="@color/black"
            android:padding="12dp"
            android:textColor="@color/Gold"
            android:textColorHint="@color/Gold"
            android:textSize="16sp"
            android:inputType="textMultiLine" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/cinzel"
            android:text="SEND MESSAGE"
            android:textColor="@color/Gold"
            android:textSize="16sp"
            app:backgroundTint="@color/black" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

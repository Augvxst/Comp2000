<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Stafflist">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="25dp"


        android:gravity="center"
        >
        <Button
            android:id="@+id/homeButton"
            android:layout_marginEnd="50dp"
            android:background="@drawable/house"
            app:backgroundTint="@color/Gold"
            android:layout_width="64dp"
            android:layout_height="64dp"

            />

        <Button
            android:id="@+id/staffButton"
            android:background="@drawable/staff"
            app:backgroundTint="@color/Gold"
            android:layout_width="64dp"
            android:layout_height="64dp"

            />

        <Button
            android:id="@+id/settingsButton"
            android:background="@drawable/cog"
            app:backgroundTint="@color/Gold"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="50dp"


            />
    </LinearLayout>

    <Button
        android:id="@+id/backButton"
        android:layout_marginTop="16dp"
        android:background="@drawable/returnbutton"
        android:textColor="@color/black"
        app:backgroundTint="@color/Gold"

        android:layout_width="64dp"
        android:layout_height="64dp"
        android:orientation="vertical"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="25dp"

        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginBottom="100dp"
        android:background="@color/Gold"
        android:textColor="@color/Gold"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <TextView
        android:id="@+id/staffText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Staff List"
        android:fontFamily="@font/cinzel"
        android:textColor="@color/Gold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginBottom="580dp"
        android:textSize="40sp"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">




    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="140dp"
        android:layout_marginBottom="120dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:background="@color/Gold"
                    android:src="@drawable/person" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="16dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="31dp"
                        android:text="John Smith"

                        android:textColor="@color/Gold"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="129dp"
                        android:layout_height="20dp"
                        android:text="       He / Him"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:background="@color/Gold"
                    android:src="@drawable/person" />

                <LinearLayout
                    android:layout_width="132dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="16dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="146dp"
                        android:layout_height="31dp"
                        android:text="Sarah Jones"
                        android:textColor="@color/Gold"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="97dp"
                        android:layout_height="35dp"
                        android:text="      She / Her"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:background="@color/Gold"
                    android:src="@drawable/person" />

                <LinearLayout
                    android:layout_width="248dp"
                    android:layout_height="61dp"
                    android:layout_marginStart="16dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical">


                <TextView
                    android:layout_width="137dp"
                    android:layout_height="30dp"
                    android:text="  Alex Brown"
                    android:textColor="@color/Gold"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="109dp"
                    android:layout_height="28dp"
                    android:text="    They / Them"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:background="@color/Gold"
                    android:src="@drawable/person" />

                <LinearLayout
                    android:layout_width="248dp"
                    android:layout_height="61dp"
                    android:layout_marginStart="16dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="139dp"
                        android:layout_height="27dp"
                        android:text="Emily Wilson"
                        android:textColor="@color/Gold"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="142dp"
                        android:layout_height="26dp"
                        android:text="     She / Her"
                        android:textColor="@color/white"
                        android:textSize="16sp" />
                </LinearLayout>


            </LinearLayout>



        </LinearLayout>

    </ScrollView>





</androidx.constraintlayout.widget.ConstraintLayout>